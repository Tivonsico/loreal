# 可选。启动脚本会自动设置角色和端口。
APP_DATABASE_URL=sqlite:///./data/app.db
APP_MEDIA_DIR=./data/media
APP_MAX_UPLOAD_BYTES=52428800
APP_POLL_INTERVAL=0.2

# OpenAI 兼容的 Chat Completions 接口。真实密钥只填写到本地 .env，不要提交。
# 更换模型服务时，通常只需要修改下面三项；BASE_URL 应以 /v1 结尾。
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
LLM_TIMEOUT_SECONDS=30
# 某些兼容服务不支持 response_format；遇到参数不支持时改为 false。
LLM_JSON_MODE=true
